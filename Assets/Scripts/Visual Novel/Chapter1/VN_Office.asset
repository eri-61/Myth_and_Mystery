    - Rafael
    dialog:
    - Hey! Javier, wake up! Wake up, it's time to open the agency!
    - Ugh.. You're too loud.
    - Seriously? Did you fall asleep at the office again?
    endAfterDialog: 0
    nextDialog: -1
